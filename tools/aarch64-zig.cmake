# CMake toolchain: SurgeXXL for the 64-bit MPCs (MPC Live III, MPC XL: aarch64, glibc 2.31) with zig (pip install ziglang)
get_filename_component(SXXL_ZIG "${CMAKE_CURRENT_LIST_DIR}/zig" ABSOLUTE)
get_filename_component(SXXL_ZIG64 "${CMAKE_CURRENT_LIST_DIR}/zig64" ABSOLUTE)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER ${SXXL_ZIG64}/zcc)
set(CMAKE_CXX_COMPILER ${SXXL_ZIG64}/zcxx)
set(CMAKE_ASM_COMPILER ${SXXL_ZIG64}/zcc)
set(CMAKE_AR ${SXXL_ZIG}/zar)
set(CMAKE_RANLIB ${SXXL_ZIG}/zranlib)
set(LUAJIT_HOSTCC ${SXXL_ZIG64}/hostcc64 CACHE FILEPATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_C_FLAGS_INIT "-funwind-tables")
set(CMAKE_CXX_FLAGS_INIT "-funwind-tables")
