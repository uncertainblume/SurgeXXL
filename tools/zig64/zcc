#!/bin/sh
# zig's C compiler for the 64-bit MPCs (MPC Live III, MPC XL and later): aarch64, glibc 2.31, the Cortex-A55 baseline
# the MPC plugin SDK names (mpc-plugin-builder-sdk docs/building.md).
exec ${ZIG:-python3 -m ziglang} cc -target aarch64-linux-gnu.2.31 -mcpu=cortex_a55 -fno-sanitize=all -Wno-date-time "$@"
